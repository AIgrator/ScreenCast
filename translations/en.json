  "token_help": "Filename format (strftime + {n}):\n\n  %Y  — year (2026)\n  %m  — month (01–12)\n  %d  — day (01–31)\n  %H  — hour (00–23)\n  %M  — minute (00–59)\n  %S  — second (00–59)\n  %a  — weekday (Mon, Tue...)\n  %b  — month (Jan, Feb...)\n\n  {n}     — number (auto: 1, 2, 3...)\n  {n:03}  — zero-padded number (001, 002...)\n  {n:04}  — (0001, 0002...)\n\nExamples:\n  %Y%m%d-%H%M%S      →  20260903-171530\n  %Y-%m-%d_%H-%M-%S  →  2026-09-03_17-15-30\n  rec_{n:03}          →  rec_001, rec_002...\n  lecture_%Y%m%d      →  lecture_20260903\n  %b %d %Y {n:02}     →  Sep 03 2026 01",

